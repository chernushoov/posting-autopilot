{
	email {$LETSENCRYPT_EMAIL}
}

(security_headers) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://graph.facebook.com https://api.stripe.com https://r.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com;"
	}
}

(app_proxy) {
	import security_headers
	reverse_proxy web:8000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}

{$MARKETING_DOMAIN} {
	import security_headers

	@app_routes path /login /logout /register /user-login /dashboard /pricing /billing* /profile* /companies* /vacancies* /sources* /campaigns* /candidates* /analytics* /connect* /creatives* /prospecting* /demo* /api/*
	redir @app_routes https://{$APP_DOMAIN}{uri} 302

	reverse_proxy web:8000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}

{$APP_DOMAIN} {
	# One-time Facebook login viewer (noVNC) — gated by the app session via
	# forward_auth. handle_path strips the /fbvnc prefix before proxying to the
	# in-container websockify. NO strict CSP here: noVNC needs eval/blob/workers.
	# x11vnc binds 127.0.0.1 inside the web container; websockify (web:6080) is
	# reachable only on the docker network and only after /authz returns 200.
	handle_path /fbvnc/* {
		forward_auth web:8000 {
			uri /connect/facebook/capture/authz
		}
		header {
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			Cache-Control "no-store"
		}
		reverse_proxy web:6080
	}

	handle {
		import security_headers

		@root path /
		redir @root /login 302

		reverse_proxy web:8000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
}
