# Keep secrets + runtime data + dev junk out of the image (sec audit M8)
.git/
.gitignore
data/
*.db
*.sqlite
*.session
.env
.env.*
!.env.example
!.env.production.example
!.env.prod.example
.venv*/
__pycache__/
*.pyc
*.pyo
node_modules/
*.log
.DS_Store
ops/
*.md
!templates/**/*.md
.claude/
.pytest_cache/
shot*.js
ver.js
fb.js
tg.js
cap.js
auth-shot.js
