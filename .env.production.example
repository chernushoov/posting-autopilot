# ============================================================================
# Posting Autopilot — PRODUCTION env template.
# Copy to .env on the server and fill every value. Never commit the real .env.
#   cp .env.production.example .env && nano .env
# ============================================================================

# --- Web ---
FLASK_SECRET_KEY=            # 64+ random hex chars: `openssl rand -hex 32`
ALLOW_INSECURE_DEV_SECRET=0
FORCE_HTTPS=1               # required behind the Caddy HTTPS proxy (secure cookies)
ADMIN_LOGIN=operator
ADMIN_PASSWORD=             # strong unique password (this is your admin panel login)

# --- Public domain (used by Caddy for auto-HTTPS) ---
DOMAIN=                      # e.g. app.posting-autopilot.com  (A record -> this server)

# --- Database (Postgres in compose) ---
POSTGRES_PASSWORD=          # strong DB password
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@postgres:5432/ra   # CHANGE_ME == POSTGRES_PASSWORD

# --- Redis / queue ---
REDIS_URL=redis://redis:6379/0
RQ_DEFAULT_QUEUE=default
RQ_WORKER_TIMEOUT=900

# --- Telegram bot (DM screening + hot-lead notifications) ---
RECRUITBOT_TELEGRAM_BOT_TOKEN=   # dedicated bot token from @BotFather (NOT the main bot)
TELEGRAM_BOT_TOKEN=              # same value
RECRUIT_OPERATOR_NOTIFY_CHAT=    # your numeric TG user id for 🔥 hot-lead pings (optional but recommended)

# --- AI (candidate scoring + conversation) ---
AI_PROVIDER=openai
AI_API_KEY=                      # sk-... OpenAI key (without it the bot silently drops to keyword scoring)
RECRUITBOT_AI_PROVIDER=openai
RECRUITBOT_AI_API_KEY=

# --- Facebook (manual-assisted path; OAuth Pages optional) ---
FB_APP_ID=
FB_APP_SECRET=

# --- Stripe billing (see STRIPE_RUNBOOK.md) ---
STRIPE_SECRET_KEY=               # sk_live_... (or sk_test_... while testing)
STRIPE_PUBLISHABLE_KEY=          # pk_live_...
STRIPE_WEBHOOK_SECRET=           # whsec_...  (REQUIRED — unsigned webhooks are rejected)
STRIPE_PRICE_STARTER=            # price_...  (₪299/mo recurring price id)
STRIPE_PRICE_PRO=                # price_...  (₪899/mo)
STRIPE_PRICE_AGENCY=             # price_...  (₪1999/mo)

# --- Email digests / hot-lead email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Locale ---
DEFAULT_LANG=he
