# Backward-compatible alias for the deploy template.
# Prefer .env.prod.example for new deployments.

APP_ENV=production
FORCE_HTTPS=1
ALLOW_INSECURE_DEV_SECRET=0
ALLOW_INLINE_POSTING=0
ALLOW_STUB_AI=0
BILLING_ENABLED=0

ADMIN_LOGIN=operator
ADMIN_PASSWORD=CHANGE_ME_OPERATOR_PASSWORD
FLASK_SECRET_KEY=CHANGE_ME_FLASK_SECRET_64_CHAR_MINIMUM

MARKETING_DOMAIN=posting-autopilot.com
APP_DOMAIN=app.posting-autopilot.com
PUBLIC_MARKETING_URL=https://posting-autopilot.com
PUBLIC_APP_URL=https://app.posting-autopilot.com
LETSENCRYPT_EMAIL=ops@example.com

POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/ra
REDIS_URL=redis://redis:6379/0

RQ_DEFAULT_QUEUE=default
RQ_WORKER_TIMEOUT=900
WEB_CONCURRENCY=2
WEB_THREADS=4
DEFAULT_LANG=he

TRIAL_DAYS=3
SIGNUP_INVITE_CODE=

RECRUITBOT_TELEGRAM_BOT_TOKEN=CHANGE_ME_BOTFATHER_TOKEN
TELEGRAM_BOT_TOKEN=CHANGE_ME_BOTFATHER_TOKEN
RECRUITBOT_BOT_USERNAME=
RECRUIT_OPERATOR_NOTIFY_CHAT=

RECRUITBOT_TG_API_ID=
RECRUITBOT_TG_API_HASH=

RECRUITBOT_AI_PROVIDER=openai
RECRUITBOT_AI_API_KEY=
AI_PROVIDER=openai
AI_API_KEY=

FB_ALLOW_LOCAL_CAPTURE=0
FB_APP_ID=
FB_APP_SECRET=
FB_BROWSER_SESSION_NAME=
# Server-side one-time FB login via noVNC (cloud). 1 = enabled.
FB_SERVER_CAPTURE=
# Anti-ban: route the FB login capture AND the headless poster through the SAME
# residential/mobile proxy so Facebook never sees a bare datacenter IP. Leave
# empty for local/desktop (residential IP). Set all three on the server.
FB_PROXY_SERVER=
FB_PROXY_USERNAME=
FB_PROXY_PASSWORD=

# Web analytics (empty = off). CF: Cloudflare dash -> Web Analytics -> token.
# Clarity: clarity.microsoft.com -> project -> id.
CF_ANALYTICS_TOKEN=
CLARITY_ID=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
