# Web
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=replace-with-64-char-random-secret
# Local-only escape hatch. Keep 0/empty outside throwaway development runs.
ALLOW_INSECURE_DEV_SECRET=0
ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace-with-strong-admin-password

# DB
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/ra

# Redis / RQ
REDIS_URL=redis://redis:6379/0
RQ_DEFAULT_QUEUE=default

# Telegram
# Use a dedicated Recruit bot token here. Do not reuse the main MoltBot/OpenClaw token.
# For local ops you can also keep the real value in .env.runtime instead.
RECRUITBOT_TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# AI Provider (stub)
# Runtime-only secrets can also live in .env.runtime.
RECRUITBOT_AI_PROVIDER=
RECRUITBOT_AI_API_KEY=
AI_PROVIDER=stub
AI_API_KEY=

# Stripe billing (see STRIPE_RUNBOOK.md). Unsigned webhooks are rejected, so
# STRIPE_WEBHOOK_SECRET is required once billing is enabled.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Facebook (manual-assisted path + optional OAuth Pages)
FB_APP_ID=
FB_APP_SECRET=

# Hot-lead notifications fallback (your numeric Telegram user id)
RECRUIT_OPERATOR_NOTIFY_CHAT=

# Set 1 in production behind the HTTPS proxy (secure cookies)
FORCE_HTTPS=0
